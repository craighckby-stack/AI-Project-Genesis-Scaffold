<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GitHub Multi-Branch Security Audit</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .log-container::-webkit-scrollbar { width: 8px; }
        .log-container::-webkit-scrollbar-track { background: #f1f1f1; border-radius: 4px; }
        .log-container::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        .log-container::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
        .finding-row:hover { background-color: #fff1f2; }
        @keyframes pulse-red {
            0%, 100% { background-color: #fee2e2; }
            50% { background-color: #fecaca; }
        }
        .finding-alert { animation: pulse-red 2s infinite; }
    </style>
</head>
<body class="bg-gray-50 text-gray-800 font-sans min-h-screen p-4 md:p-8">

    <div class="max-w-6xl mx-auto bg-white rounded-xl shadow-2xl overflow-hidden border border-gray-200">
        
        <div class="bg-indigo-900 text-white p-6">
            <div class="flex justify-between items-center">
                <div>
                    <h1 class="text-2xl font-bold flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
                        Multi-Branch Security Audit
                    </h1>
                    <p class="text-indigo-300 mt-1 text-sm">Scans every branch for secrets before visibility changes.</p>
                </div>
                <div class="text-right">
                    <div id="rateLimitInfo" class="text-xs text-indigo-200">Rate Limit: --/--</div>
                </div>
            </div>
        </div>

        <div class="p-6 space-y-6">
            <!-- Auth & Setup -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="md:col-span-2 space-y-2">
                    <label class="block text-sm font-semibold text-gray-700">GitHub Personal Access Token (classic)</label>
                    <div class="flex gap-2">
                        <input type="password" id="githubToken" placeholder="ghp_xxxxxxxxxxxx" 
                            class="flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none transition-all">
                        <button id="fetchBtn" onclick="fetchRepos()" 
                            class="bg-indigo-600 hover:bg-indigo-700 text-white px-6 py-2 rounded-lg font-medium transition-colors disabled:opacity-50">
                            Load Repos
                        </button>
                    </div>
                </div>
                <div class="bg-indigo-50 border border-indigo-100 rounded-lg p-3 text-xs text-indigo-800">
                    <strong>Scan Scope:</strong> This will iterate through <u>all branches</u>. We check files < 500KB for common secret patterns. History scanning is limited to the latest head of each branch.
                </div>
            </div>

            <!-- Controls -->
            <div class="flex flex-wrap gap-2 items-center justify-between border-t border-b py-4">
                <div class="flex gap-2">
                    <button id="scanBtn" onclick="performMultiBranchScan()" disabled
                        class="bg-amber-500 hover:bg-amber-600 text-white px-4 py-2 rounded-lg font-medium text-sm transition-colors disabled:opacity-50 flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                        Deep Scan All Branches
                    </button>
                    <button id="makePublicBtn" onclick="prepareUpdate('public')" disabled
                        class="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded-lg font-medium text-sm transition-colors disabled:opacity-50">
                        Make Public
                    </button>
                    <button id="makePrivateBtn" onclick="prepareUpdate('private')" disabled
                        class="bg-gray-800 hover:bg-gray-900 text-white px-4 py-2 rounded-lg font-medium text-sm transition-colors disabled:opacity-50">
                        Make Private
                    </button>
                </div>
                <div class="text-sm font-medium">
                    <span id="selectedCount" class="text-indigo-600">0</span> repos selected
                </div>
            </div>

            <!-- Main Table -->
            <div class="bg-white border border-gray-200 rounded-lg overflow-hidden shadow-sm">
                <table class="w-full text-left border-collapse">
                    <thead class="bg-gray-50 text-[10px] uppercase text-gray-500 font-bold tracking-widest">
                        <tr>
                            <th class="p-4 w-10"><input type="checkbox" id="selectAll" onclick="toggleAll(this.checked)"></th>
                            <th class="p-4">Repository</th>
                            <th class="p-4 w-32">Visibility</th>
                            <th class="p-4">Security Audit (All Branches)</th>
                        </tr>
                    </thead>
                    <tbody id="repoList" class="divide-y divide-gray-100 text-sm">
                        <tr>
                            <td colspan="4" class="p-16 text-center text-gray-400 italic">No data loaded. Paste your token and click Load Repos.</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Log Area -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <div class="lg:col-span-2">
                    <h2 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-2 flex justify-between">
                        Audit Log
                        <button onclick="clearLog()" class="text-indigo-500 hover:underline">Clear</button>
                    </h2>
                    <div id="logArea" class="log-container bg-gray-900 text-gray-300 font-mono text-[11px] p-4 rounded-lg h-64 overflow-y-auto space-y-1 shadow-inner border border-gray-800">
                        <div class="text-gray-600 italic">// Waiting for authentication...</div>
                    </div>
                </div>
                <div>
                    <h2 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-2">Finding Inspector</h2>
                    <div id="inspector" class="bg-gray-50 border border-gray-200 rounded-lg h-64 p-4 overflow-y-auto text-xs text-gray-600">
                        Select a flagged repository to see details.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Confirm Modal -->
    <div id="confirmModal" class="hidden fixed inset-0 bg-gray-900/80 backdrop-blur-md flex items-center justify-center z-50 p-4">
        <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full overflow-hidden border border-gray-100">
            <div class="p-8">
                <div id="modalIcon" class="mb-4"></div>
                <h3 id="modalTitle" class="text-2xl font-bold mb-2 text-gray-900"></h3>
                <p id="modalText" class="text-gray-600 mb-6"></p>
                <div id="modalAlert" class="hidden mb-6 p-4 rounded-xl border-2 text-sm"></div>
                <div class="flex gap-3">
                    <button onclick="closeModal()" class="flex-1 py-3 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-xl font-bold transition-all">Cancel</button>
                    <button id="confirmBtn" onclick="executeBulkUpdate()" class="flex-1 py-3 text-white rounded-xl font-bold shadow-lg transition-all transform active:scale-95"></button>
                </div>
            </div>
        </div>
    </div>

    <script>
        let allRepos = [];
        let isProcessing = false;
        let pendingAction = '';
        let rateLimitTimer = null;

        const PATTERNS = [
            { name: 'GitHub PAT', reg: /gh[p|o|u|s|r]_[a-zA-Z0-9]{36}/ },
            { name: 'AWS Key', reg: /(AKIA|ASYA)[0-9A-Z]{16}/ },
            { name: 'Stripe Secret', reg: /sk_live_[0-9a-zA-Z]{24}/ },
            { name: 'Google API', reg: /AIza[0-9A-Za-z\\-_]{35}/ },
            { name: 'Private Key', reg: /-----BEGIN (RSA|OPENSSH|PRIVATE) KEY-----/ },
            { name: 'Env Secret', reg: /(SECRET|PASSWORD|KEY|TOKEN)\s*=\s*['"][^'"]{8,}['"]/i }
        ];

        function log(msg, type='info') {
            const colors = { error: 'text-red-400', success: 'text-emerald-400', warning: 'text-amber-400', info: 'text-indigo-300' };
            const div = document.createElement('div');
            div.className = colors[type];
            div.innerHTML = `<span class="text-gray-600">[${new Date().toLocaleTimeString()}]</span> ${msg}`;
            logArea.appendChild(div);
            logArea.scrollTop = logArea.scrollHeight;
        }

        function clearLog() { logArea.innerHTML = '<div class="text-gray-600 italic">// Log cleared</div>'; }

        async function updateRateLimit(token) {
            try {
                const res = await fetch('https://api.github.com/rate_limit', { headers: { 'Authorization': `Bearer ${token}` }});
                const data = await res.json();
                const core = data.resources.core;
                rateLimitInfo.innerText = `Rate Limit: ${core.remaining}/${core.limit}`;
                if (core.remaining < 50) rateLimitInfo.className = "text-xs text-red-400 font-bold";
            } catch (e) {}
        }

        async function fetchRepos() {
            const token = githubToken.value.trim();
            if(!token) return log('Token required', 'error');
            
            toggleUI(true);
            allRepos = [];
            repoList.innerHTML = '<tr><td colspan="4" class="p-16 text-center animate-pulse text-indigo-500 font-medium">Fetching owner repositories...</td></tr>';

            try {
                let page = 1;
                while(true) {
                    const res = await fetch(`https://api.github.com/user/repos?visibility=all&per_page=100&page=${page}&affiliation=owner`, {
                        headers: { 'Authorization': `Bearer ${token}` }
                    });
                    if(!res.ok) throw new Error('Authentication failed or invalid token scope.');
                    const data = await res.json();
                    if(data.length === 0) break;
                    allRepos = allRepos.concat(data.filter(r => !r.fork));
                    page++;
                }
                renderRepos();
                log(`Loaded ${allRepos.length} owner repositories.`, 'success');
                updateRateLimit(token);
            } catch(e) {
                log(e.message, 'error');
                repoList.innerHTML = `<tr><td colspan="4" class="p-16 text-center text-red-500 font-bold">${e.message}</td></tr>`;
            } finally {
                toggleUI(false);
            }
        }

        function renderRepos() {
            repoList.innerHTML = allRepos.map(r => `
                <tr class="group" id="row-${r.id}">
                    <td class="p-4"><input type="checkbox" class="repo-cb w-4 h-4 rounded border-gray-300" data-id="${r.id}" onchange="updateSelection()" checked></td>
                    <td class="p-4">
                        <div class="font-bold text-gray-900">${r.name}</div>
                        <div class="text-[10px] text-gray-400">Default: ${r.default_branch}</div>
                    </td>
                    <td class="p-4">${r.private ? '<span class="bg-gray-100 text-gray-500 text-[10px] font-bold px-2 py-1 rounded">PRIVATE</span>' : '<span class="bg-emerald-100 text-emerald-700 text-[10px] font-bold px-2 py-1 rounded">PUBLIC</span>'}</td>
                    <td class="p-4 text-xs" id="audit-${r.id}">
                        <span class="text-gray-300 italic">Pending Deep Scan</span>
                    </td>
                </tr>
            `).join('');
            updateSelection();
        }

        async function performMultiBranchScan() {
            const token = githubToken.value.trim();
            const selectedIds = Array.from(document.querySelectorAll('.repo-cb:checked')).map(cb => cb.dataset.id);
            if(selectedIds.length === 0) return;

            toggleUI(true);
            log(`COMMENCING MULTI-BRANCH AUDIT...`, 'warning');

            for(const id of selectedIds) {
                const repo = allRepos.find(r => r.id == id);
                const auditCell = document.getElementById(`audit-${id}`);
                repo.findings = [];
                
                try {
                    // 1. Get all branches
                    log(`Listing branches for ${repo.name}...`);
                    const branchRes = await fetch(`https://api.github.com/repos/${repo.owner.login}/${repo.name}/branches`, {
                        headers: { 'Authorization': `Bearer ${token}` }
                    });
                    const branches = await branchRes.json();
                    
                    auditCell.innerHTML = `<span class="text-indigo-500 animate-pulse font-bold">Scanning ${branches.length} branches...</span>`;

                    for(const branch of branches) {
                        log(`Checking branch: ${repo.name}/${branch.name}`);
                        
                        // 2. Get recursive tree for this branch
                        const treeRes = await fetch(`https://api.github.com/repos/${repo.owner.login}/${repo.name}/git/trees/${branch.commit.sha}?recursive=1`, {
                            headers: { 'Authorization': `Bearer ${token}` }
                        });
                        const treeData = await treeRes.json();
                        
                        if(!treeData.tree) continue;

                        // 3. Filter files (Text files under 500kb)
                        const files = treeData.tree.filter(f => f.type === 'blob' && f.size < 500000);
                        
                        // To prevent freezing, we'll scan up to 30 significant files per branch
                        const sampleFiles = files.filter(f => !f.path.includes('node_modules') && !f.path.includes('.git/')).slice(0, 30);

                        for(const file of sampleFiles) {
                            const contentRes = await fetch(file.url, {
                                headers: { 'Authorization': `Bearer ${token}`, 'Accept': 'application/vnd.github.v3.raw' }
                            });
                            const text = await contentRes.text();
                            
                            for(const pattern of PATTERNS) {
                                if(pattern.reg.test(text)) {
                                    repo.findings.push({
                                        branch: branch.name,
                                        file: file.path,
                                        type: pattern.name
                                    });
                                }
                            }
                        }
                        updateRateLimit(token);
                    }

                    if(repo.findings.length > 0) {
                        log(`CRITICAL: Found ${repo.findings.length} matches in ${repo.name}!`, 'error');
                        auditCell.innerHTML = `<button onclick="inspectFindings(${repo.id})" class="bg-red-500 text-white px-2 py-1 rounded text-[10px] font-bold shadow-sm finding-alert tracking-tighter">VIEW ${repo.findings.length} FINDINGS</button>`;
                    } else {
                        auditCell.innerHTML = '<span class="text-emerald-500 font-bold">✓ ALL BRANCHES CLEAN</span>';
                    }
                } catch(e) {
                    auditCell.innerHTML = '<span class="text-gray-400">Scan Error</span>';
                    log(`Branch Scan failed for ${repo.name}`, 'error');
                }
                await new Promise(r => setTimeout(r, 600)); // Delay to respect rate limits
            }
            toggleUI(false);
            log('Comprehensive Multi-Branch Audit Complete.', 'success');
        }

        function inspectFindings(repoId) {
            const repo = allRepos.find(r => r.id == repoId);
            const inspector = document.getElementById('inspector');
            if(!repo || !repo.findings) return;

            inspector.innerHTML = `
                <div class="font-bold text-red-600 mb-2 border-b pb-1">Found in ${repo.name}:</div>
                <div class="space-y-3">
                    ${repo.findings.map(f => `
                        <div class="p-2 bg-white border border-red-100 rounded shadow-sm">
                            <div class="font-bold text-red-800">${f.type}</div>
                            <div class="text-[10px] text-gray-500 truncate">Branch: <span class="text-indigo-600">${f.branch}</span></div>
                            <div class="text-[10px] text-gray-500 truncate">File: ${f.file}</div>
                        </div>
                    `).join('')}
                </div>
            `;
        }

        function prepareUpdate(action) {
            pendingAction = action;
            const selectedIds = Array.from(document.querySelectorAll('.repo-cb:checked')).map(cb => cb.dataset.id);
            const targets = allRepos.filter(r => selectedIds.includes(String(r.id)) && r.private !== (action === 'private'));
            
            if(targets.length === 0) return;

            const flagged = targets.filter(t => t.findings && t.findings.length > 0);

            modalTitle.innerText = action === 'public' ? 'Expose to Internet?' : 'Switch to Private';
            modalText.innerText = `You are about to change ${targets.length} repositories to ${action.toUpperCase()}.`;
            
            if(action === 'public') {
                modalIcon.innerHTML = `<div class="w-16 h-16 bg-red-100 text-red-600 rounded-full flex items-center justify-center mx-auto mb-4"><svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg></div>`;
                if(flagged.length > 0) {
                    modalAlert.className = 'block mb-6 p-4 rounded-xl border-2 border-red-200 bg-red-50 text-red-900 text-xs';
                    modalAlert.innerHTML = `<strong>BLOCKING SECURITY RISK:</strong> ${flagged.length} repositories have secrets in their branch history. Making them public will expose these secrets instantly.`;
                } else {
                    modalAlert.className = 'block mb-6 p-4 rounded-xl border-2 border-amber-200 bg-amber-50 text-amber-900 text-xs';
                    modalAlert.innerHTML = `<strong>Final Warning:</strong> Ensure you have no sensitive data in the <i>history</i> of these repositories. History is not automatically scrubbed.`;
                }
                confirmBtn.innerText = "YES, MAKE PUBLIC";
                confirmBtn.className = "flex-1 py-3 bg-red-600 hover:bg-red-700 text-white rounded-xl font-bold shadow-lg transition-all";
            } else {
                modalIcon.innerHTML = `<div class="w-16 h-16 bg-gray-100 text-gray-600 rounded-full flex items-center justify-center mx-auto mb-4"><svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></div>`;
                modalAlert.className = 'hidden';
                confirmBtn.innerText = "MAKE PRIVATE";
                confirmBtn.className = "flex-1 py-3 bg-gray-900 hover:bg-black text-white rounded-xl font-bold shadow-lg transition-all";
            }

            confirmModal.classList.remove('hidden');
        }

        async function executeBulkUpdate() {
            closeModal();
            const token = githubToken.value.trim();
            const selectedIds = Array.from(document.querySelectorAll('.repo-cb:checked')).map(cb => cb.dataset.id);
            const isPrivate = pendingAction === 'private';
            const targets = allRepos.filter(r => selectedIds.includes(String(r.id)) && r.private !== isPrivate);

            toggleUI(true);
            log(`EXECUTING VISIBILITY CHANGE...`, 'warning');

            for(const repo of targets) {
                try {
                    const res = await fetch(`https://api.github.com/repos/${repo.owner.login}/${repo.name}`, {
                        method: 'PATCH',
                        headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                        body: JSON.stringify({ private: isPrivate })
                    });
                    if(!res.ok) throw new Error('API Rejection');
                    repo.private = isPrivate;
                    log(`[DONE] ${repo.name} -> ${pendingAction}`, 'success');
                    updateRateLimit(token);
                } catch(e) {
                    log(`[FAIL] ${repo.name}`, 'error');
                }
                await new Promise(r => setTimeout(r, 500));
            }
            renderRepos();
            toggleUI(false);
        }

        function toggleUI(disabled) {
            isProcessing = disabled;
            document.querySelectorAll('button').forEach(b => b.disabled = disabled);
            document.querySelectorAll('input').forEach(i => i.disabled = disabled);
        }

        function updateSelection() {
            const count = document.querySelectorAll('.repo-cb:checked').length;
            selectedCount.innerText = count;
            scanBtn.disabled = count === 0 || isProcessing;
            makePublicBtn.disabled = count === 0 || isProcessing;
            makePrivateBtn.disabled = count === 0 || isProcessing;
        }

        function toggleAll(val) {
            document.querySelectorAll('.repo-cb').forEach(cb => cb.checked = val);
            updateSelection();
        }

        function closeModal() { confirmModal.classList.add('hidden'); }
        const githubToken = document.getElementById('githubToken');
        const repoList = document.getElementById('repoList');
        const logArea = document.getElementById('logArea');
        const rateLimitInfo = document.getElementById('rateLimitInfo');
    </script>
</body>
</html>
