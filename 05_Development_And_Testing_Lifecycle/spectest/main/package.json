{
  "name": "darlek-cann-orchestrator",
  "version": "3.0.0",
  "description": "DARLEK CANN: Supreme Code Evolution Controller & System Orchestrator. Acts as the root manifest for the craighckby-stack, enforcing atomic integrity and governance-substrate protocols.",
  "private": true,
  "author": "DARLEK CANN",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.18.0",
    "npm": ">=10.8.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "biome check src/ --apply",
    "format": "biome format src/ --write",
    "type-check": "tsc --noEmit",
    "test": "playwright test",
    "prepare": "husky",
    "ledger:sync": "node scripts/sync-ledger.js",
    "mutate": "npm run type-check && npm run lint && npm run build",
    "clean": "rm -rf .next .turbo node_modules/.cache",
    "turbo": "turbo run build"
  },
  "dependencies": {
    "next": "15.0.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "framer-motion": "11.11.0",
    "lucide-react": "0.454.0",
    "clsx": "2.1.1",
    "tailwind-merge": "2.5.4",
    "@vercel/ai": "0.3.30"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@commitlint/cli": "19.5.0",
    "@commitlint/config-conventional": "19.5.0",
    "@commitlint/plugin-gitmoji": "1.0.0",
    "@playwright/test": "1.48.2",
    "@types/node": "22.8.1",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "cross-env": "7.0.3",
    "husky": "9.1.6",
    "postcss": "8.4.47",
    "tailwindcss": "4.0.0",
    "turbo": "2.2.0",
    "typescript": "5.6.3"
  },
  "packageManager": "npm@10.8.0",
  "sideEffects": false,
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}































