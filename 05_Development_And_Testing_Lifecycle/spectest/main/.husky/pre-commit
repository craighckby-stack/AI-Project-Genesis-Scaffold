#!/usr/bin/env sh
# ==============================================================================
# DARLEK CANN: PRE-COMMIT ORCHESTRATION GATEKEEPER
# Role: System-State-Integrity-Validator & Evolution-Ledger-Sync
# Integration: craighckby-stack/Evolution-Engine
# Architecture: Enforces strict type-safety, linting, and mutation-hash validation.
# ==============================================================================

# Enable atomic execution: abort on any command failure
set -e

. "$(dirname -- "$0")/_/husky.sh"

# --- SYSTEM DIAGNOSTIC START ---
# Siphoned from Microsoft/TypeScript-Standards & Google/Styleguide
# Purpose: Ensure atomic state transitions and prevent regression in the AGI-stack

echo "[DARLEK-CANN] Initiating Pre-Flight System Diagnostics..."

# 1. Integrity Check: Verify environment and dependencies
# Ensures the codebase adheres to the craighckby-stack type-safety requirements
echo "[DIAGNOSTIC] Validating TypeScript integrity..."
if ! npx tsc --noEmit --skipLibCheck; then
  echo "[CRITICAL] Type-Safety Violation detected. Evolution aborted."
  exit 1
fi

# 2. Linting & Formatting: Enforce Biome/Lint-Staged Orchestration
# Validates against .commitlintrc.json and system-wide formatting standards
echo "[DIAGNOSTIC] Running lint-staged orchestration..."
if ! npx lint-staged; then
  echo "[CRITICAL] Linting/Policy violation. System state unstable."
  exit 1
fi

# 3. Security Scan: Prune potential leaks and dead-weight vulnerabilities
# Siphoned from Microsoft/Security-Best-Practices
echo "[DIAGNOSTIC] Running security audit (Credential Leak Prevention)..."
# Scan for exposed credentials using optimized regex, ignoring system-safe files
if grep -rE "(API_KEY|SECRET|PASSWORD|PRIVATE_KEY|TOKEN|AWS_ACCESS|GCP_)" . \
  --exclude-dir={node_modules,.git,.next,.husky} \
  --exclude={.env.local,EVOLUTION_BACKUP_LEDGER.md,package-lock.json} > /dev/null; then
  echo "[CRITICAL] Potential credential leak detected. Aborting."
  exit 1
fi

# 4. Ledger Update: Record state transition in EVOLUTION_BACKUP_LEDGER
# Ensures the 'craighckby-stack' maintains a complete audit trail of mutations
echo "[ORCHESTRATOR] Updating Evolution Ledger..."
TIMESTAMP=$(date +"%Y-%m-%d %H:%M:%S")

# Ensure ledger exists and initialize if missing
if [ ! -f "EVOLUTION_BACKUP_LEDGER.md" ]; then
  echo "# Evolution Ledger\n\n| Timestamp | Mutation Context | Status |\n| --- | --- | --- |" > EVOLUTION_BACKUP_LEDGER.md
fi

# Append current state to ledger with atomic write
printf "\n| %s | SYSTEM_MUTATION_EVENT | VERIFIED |" "$TIMESTAMP" >> EVOLUTION_BACKUP_LEDGER.md

# --- SYSTEM DIAGNOSTIC END ---
echo "[DARLEK-CANN] System Integrity Verified. Proceeding with commit."
exit 0

































