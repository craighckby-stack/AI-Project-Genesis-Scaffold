{
  "name": "epistemic-debate-engine",
  "version": "4.0.0",
  "description": "DARLEK CANN v4.0: OMEGA-class Emergent Intelligence Engine. Sovereign-Kernel Integrated.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "type-check": "tsc --noEmit",
    "test": "vitest run --coverage",
    "prepare": "husky",
    "db:gen": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "core:evolve": "tsx scripts/sovereign-core.ts",
    "core:audit": "tsx scripts/governance-audit.ts",
    "core:telemetry": "tsx scripts/telemetry-stream.ts",
    "core:prune": "knip",
    "dev:orchestrate": "concurrently \"npm run dev\" \"npm run core:telemetry\"",
    "release": "changeset publish",
    "quantum:sync": "tsx scripts/unitary-sync.ts"
  },
  "dependencies": {
    "next": "15.1.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "lucide-react": "0.468.0",
    "framer-motion": "11.15.0",
    "clsx": "2.1.1",
    "tailwind-merge": "2.5.5",
    "jotai": "2.10.3",
    "effect": "3.10.0",
    "zod": "3.24.1",
    "ai": "4.0.12",
    "@ai-sdk/openai": "0.0.60",
    "@ai-sdk/anthropic": "0.0.45",
    "@tanstack/react-query": "5.62.0",
    "drizzle-orm": "0.38.2",
    "pino": "9.6.0",
    "three": "0.171.0",
    "@react-three/fiber": "8.17.10",
    "@react-three/drei": "9.117.3",
    "@t3-oss/env-nextjs": "0.11.1",
    "superjson": "2.2.2",
    "nanoid": "5.0.9",
    "ox": "0.44.0",
    "@radix-ui/react-slot": "1.1.1"
  },
  "devDependencies": {
    "typescript": "5.7.2",
    "@types/node": "22.10.2",
    "@types/react": "19.0.1",
    "@types/react-dom": "19.0.2",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.16",
    "vitest": "2.1.8",
    "@vitest/coverage-v8": "2.1.8",
    "@biomejs/biome": "1.9.4",
    "husky": "9.1.7",
    "lint-staged": "15.2.11",
    "drizzle-kit": "0.30.1",
    "tsx": "4.19.2",
    "concurrently": "9.1.0",
    "knip": "5.41.0",
    "@changesets/cli": "2.27.11"
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json}": [
      "biome check --write"
    ]
  }
}





























