-// Node 3: Gemini (Google) — researcher mindset, large context
+// Node 3: Anthropic Claude — superior code analysis, careful reasoning
+async function tryAnthropic(context: string): Promise<{ response: string | null; provider: string; quotaHit: boolean }> {
+  const key = process.env.ANTHROPIC_API_KEY
+  if (!key) return { response: null, provider: 'anthropic', quotaHit: false }
+
+  try {
+    const res = await fetch('https://api.anthropic.com/v1/messages', {
+      method: 'POST',
+      headers: {
+        'Content-Type': 'application/json',
+        'x-api-key': key,
+        'anthropic-version': '2023-06-01',
+        'anthropic-dangerous-direct-browser-access': 'true',
+      },
+      body: JSON.stringify({
+        model: 'claude-sonnet-4-20250514',
+        max_tokens: 1024,
+        system: MENTOR_PROMPT,
+        messages: [{ role: 'user', content: context }],
+      }),
+      signal: AbortSignal.timeout(25000)
+    })
+
+    if (res.status === 429 || res.status === 503) {
+      console.warn('[Mentor Cascade] Anthropic rate limited (429/503), falling back...')
+      return { response: null, provider: 'anthropic', quotaHit: true }
+    }
+
+    if (!res.ok) {
+      console.warn(`[Mentor Cascade] Anthropic returned ${res.status}, falling back...`)
+      return { response: null, provider: 'anthropic', quotaHit: false }
+    }
+
+    const data = await res.json()
+    const text = data.content?.[0]?.text || null
+    if (text) {
+      console.log('[Mentor Cascade] Anthropic responded successfully')
+    }
+    return { response: text, provider: 'anthropic', quotaHit: false }
+  } catch (err) {
+    console.error('[Mentor Cascade] Anthropic error:', err instanceof Error ? err.message : err)
+    return { response: null, provider: 'anthropic', quotaHit: false }
+  }
+}
