# Ensures code integrity, type safety, and architectural compliance.

set -e

# 1. PRE-FLIGHT DIAGNOSTICS
echo "[DARLEK-CANN] Initiating pre-commit architectural scan..."

# 2. TYPE SAFETY & ARCHITECTURAL INTEGRITY
# Siphoned from EMG-CORE/DARLEK-CAAN-v3 build patterns
echo "[DARLEK-CANN] Validating TypeScript definitions..."
npx tsc --noEmit --project tsconfig.json

# 3. LINTING & CODE SMELL PRUNING
