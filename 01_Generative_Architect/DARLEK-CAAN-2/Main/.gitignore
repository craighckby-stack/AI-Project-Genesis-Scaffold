*.iml
*.iws
*.ipr

# --- 7. TEMPORARY & ARTIFACTS ---
*.tmp
*.temp
*.swp
*.swo
*~
.sass-cache/
.history/
.serverless/
.terraform/

# --- 8. PROJECT-SPECIFIC OVERRIDES ---
