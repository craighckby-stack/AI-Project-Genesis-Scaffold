# --- 4. QA, DIAGNOSTICS & INSTRUMENTATION ---
coverage/
.nyc_output/
.jest/
.mocha/
.cypress/
__pycache__/
*.py[cod]
.eslintcache
.stylelintcache
.prettiercache

# --- 5. SECURITY & CREDENTIALS (ABSOLUTE ZERO LEAKAGE) ---
.env*
!.env.example
!.env.template
*.pem
*.key
*.pub
*.cert
*.pfx
*.p12
*.vault
*.secret
secring.gpg
pubring.kbx
