{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RecoveryManifest",
  "type": "object",
  "properties": {
    "codes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "segment": { "type": "string" },
          "status": { "enum": ["ACTIVE", "EXHAUSTED", "REVOKED"] }
        }
      }
    }
  }
}



