.env*
!.env.example
.secrets/
*.key
*.pem
*.vault

# --- AGENT ORCHESTRATION & STATE (Siphoned from sovereign-kernel/SN-OMEGA) ---
/state/
/memory/
/logs/
/temp/
/checkpoints/
/weights/
