*.prof
*.trace
*.heapdump
/coverage/
/telemetry-data/

# --- DEPENDENCY & OS NOISE ---
node_modules/
.DS_Store
Thumbs.db
*.log

# --- DARLEK CANN EVOLUTIONARY ARTIFACTS ---
# Prevents accidental commit of self-refactoring cycles
/evolution-logs/
/refactor-diffs/
/mutation-history/

# --- IDE & EDITOR CONFIGURATION ---
.vscode/
.idea/
*.swp
*.swo
*.sublime-*

# --- UNITARY-CORE / HUXLEY-SINGULARITY-LOOP DATA ---
/quantum-buffers/
