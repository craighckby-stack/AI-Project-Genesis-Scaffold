# DARLEK CANN ENVIRONMENT TEMPLATE
# Copy this file to .env.local to configure your local agent environment.

# API KEYS
OPENAI_API_KEY=your_key_here
ANTHROPIC_API_KEY=your_key_here

# ORCHESTRATION
AGENT_ORCHESTRATION_MODE=development
LOG_LEVEL=debug

# DATABASE
DATABASE_URL=postgresql://user:password@localhost:5432/sovereign_db