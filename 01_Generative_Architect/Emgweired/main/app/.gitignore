# ==============================================================================
# DALEK CAAN Ω CODE EVOLUTION ENGINE - REPOSITORY GUARDIAN (.gitignore)
# Role: Secures the application environment, prevents leaks of sensitive credentials,
#       and filters out ephemeral build artifacts, local configurations, and heavy
#       AI/ML model weights across Next.js, Firebase, and Android sub-systems.
# Connected Components: src/lib/SubstrateExclusionRegistry.ts
# ==============================================================================

# --- SYSTEM & OS OVERHEAD ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- NODE.JS & DEPENDENCY MANAGERS ---
node_modules/
jspm_packages/
web_modules/
.npm/
.eslintcache
.stylelintcache
.prettiercache
package-lock.json
yarn.lock
pnpm-lock.yaml
bun.lockb

# --- COMPILATION & BUILD OUTPUTS ---
/build/
/dist/
/out/
/.next/
/bin/
/obj/
*.tsbuildinfo
*.pyc
__pycache__/

# --- ENVIRONMENT VARIABLES & SECRETS (ZERO-LEAK SANDBOX) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.pfx
*.p12
*.keystore
!/.env.example

# --- IDE & DEVELOPER TOOLING ---
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# --- DIAGNOSTICS & LOGS ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
firebase-debug.log*

# --- FIREBASE & CLOUD SERVICES ---
.firebase/
.runtimeconfig.json
firestore-debug.log
ui-debug.log

# --- ANDROID & NATIVE MODULES ---
.gradle/
local.properties
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.dex
*.class

# --- AI/ML ARTIFACTS & HEAVY DATASETS ---
data/
models/
checkpoints/
*.pt
*.onnx
*.h5
*.pkl
*.bin
.ipynb_checkpoints/

# --- MONOREPO & CACHE TOOLING ---
.turbo/
.cache/

# --- DALEK CAAN Ω REGISTRY INTEGRATION ---
# Logic delegated to src/lib/SubstrateExclusionRegistry.ts