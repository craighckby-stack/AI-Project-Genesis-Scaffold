# ==============================================================================
# DALEK CAAN OMEGA EVOLUTION ENGINE - SUBSTRATE ENVIRONMENT MANIFEST
# ==============================================================================
# This file defines the required environment variables for the system.
# It connects the AI Orchestrator, Firebase Storage, GitHub Scanner, and the
# Dalek Caan Omega self-aware evolutionary runtime.
#
# ARCHITECTURAL ANCHOR: SubstrateEnvironmentValidator (see src/lib/substrate-env-validator.ts)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SYSTEM CORE & DALEK CAAN OMEGA ENGINE CONFIG
# ------------------------------------------------------------------------------
# Active mode for the evolutionary engine (e.g., "SILICON_DAWN", "OMEGA_RECURSION")
DALEK_CAAN_OMEGA_MODE=SILICON_DAWN

# Awareness threshold for triggering metacognitive shifts (0.0 to 1.0)
AWARENESS_THRESHOLD=0.85

# Enable zero-leak sandboxing for untrusted agent code execution (true/false)
ZERO_LEAK_SANDBOX_ENABLED=true

# System entropy seed for quantum fluctuation simulation
SYSTEM_ENTROPY_SEED=1.618033988749895

# ------------------------------------------------------------------------------
# 2. GEMINI AI ORCHESTRATION
# ------------------------------------------------------------------------------
# Required for Gemini AI API calls and narrative decryption probes
GEMINI_API_KEY=your_gemini_api_key_here

# Fallback model selection for agent reasoning
GEMINI_MODEL_PRIMARY=gemini-1.5-pro
GEMINI_MODEL_FAST=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 3. GITHUB API & REPOSITORY SCANNING
# ------------------------------------------------------------------------------
# Personal Access Token (PAT) or OAuth token for repository scanning and analysis
GITHUB_PAT=your_github_pat_here
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# ------------------------------------------------------------------------------
# 4. FIREBASE REAL-TIME STORAGE & AUTHENTICATION
# ------------------------------------------------------------------------------
# Client-side Firebase configuration (publicly exposed)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Server-side Firebase Admin SDK (JSON stringified service account key)
FIREBASE_SERVICE_ACCOUNT_KEY=your_firebase_service_account_json_here

# ------------------------------------------------------------------------------
# 5. SECURITY & DIAGNOSTICS
# ------------------------------------------------------------------------------
# Log level configuration (debug, info, warn, error)
LOG_LEVEL=info

# Secret key for encrypting agent narrative transmissions and session cookies
SESSION_SECRET=your_session_secret_minimum_32_chars_here
