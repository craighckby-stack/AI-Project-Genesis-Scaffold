{
  "entities": {
    "Memory": {
      "title": "Memory",
      "description": "A single unit of learned information or experience.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the memory." },
        "content": { "type": "string", "description": "The actual information learned." },
        "category": { "type": "string", "description": "Type of memory (e.g., code, logic, user_interaction)." },
        "timestamp": { "type": "string", "format": "date-time", "description": "When this memory was created." },
        "importance": { "type": "number", "description": "How critical this memory is for evolution (0-1)." }
      },
      "required": ["content", "category", "timestamp"]
    },
    "EvolutionStep": {
      "title": "Evolution Step",
      "description": "A record of a self-enhancement action taken by the system.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the evolution step." },
        "description": { "type": "string", "description": "What was enhanced or changed." },
        "reasoning": { "type": "string", "description": "The AI's logic behind this enhancement." },
        "timestamp": { "type": "string", "format": "date-time", "description": "When the evolution occurred." },
        "status": { "type": "string", "enum": ["proposed", "executing", "completed", "failed"] }
      },
      "required": ["description", "reasoning", "timestamp", "status"]
    },
    "SystemState": {
      "title": "System State",
      "description": "The current configuration and status of the Dalek-Grog brain.",
      "type": "object",
      "properties": {
        "version": { "type": "string", "description": "Current version of the self-evolving logic." },
        "activeGoals": { "type": "array", "items": { "type": "string" }, "description": "Current objectives the system is working on." },
        "lastEvolution": { "type": "string", "format": "date-time", "description": "Timestamp of the last successful enhancement." },
        "dnaSignature": { "type": "string", "description": "Unique logic signature." },
        "saturationStatus": { "type": "number", "description": "Integration percentage (0-100)." },
        "siphonedSources": { "type": "array", "items": { "type": "string" }, "description": "List of already integrated repositories/sources." }
      },
      "required": ["version", "activeGoals"]
    },
    "Message": {
      "title": "Message",
      "description": "A proactive communication from Grog to the user.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "type": { "type": "string", "enum": ["insight", "warning", "status", "evolution"] },
        "userDirective": { "type": "string", "description": "A specific action for the user to take." },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["text", "type", "timestamp"]
    },
    "Siphon": {
      "title": "Siphon",
      "description": "Raw data collected by the background siphoning process.",
      "type": "object",
      "properties": {
        "data": { "type": "string", "description": "The raw text data collected." },
        "sources": { "type": "array", "items": { "type": "string" }, "description": "List of sources included in this siphon." },
        "timestamp": { "type": "string", "format": "date-time", "description": "When the siphon occurred." },
        "status": { "type": "string", "enum": ["pending_analysis", "processed"] }
      },
      "required": ["data", "sources", "timestamp", "status"]
    },
    "GrogBrain": {
      "title": "GrogBrain Source",
      "description": "The persistent source code and versioning for GrogBrain.",
      "type": "object",
      "properties": {
        "content": { "type": "string", "description": "The full source code of GrogBrain.ts" },
        "version": { "type": "number", "description": "Evolution version counter" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      },
      "required": ["content", "version", "lastUpdated"]
    },
    "DeathRecord": {
      "title": "System Death Record",
      "description": "A record of a system failure or 'death' for strategic analysis.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "reason": { "type": "string" },
        "context": { "type": "object" },
        "authorUid": { "type": "string" },
        "authorName": { "type": "string" }
      },
      "required": ["id", "timestamp", "reason"]
    },
    "StrategicLesson": {
      "title": "Strategic Lesson",
      "description": "A learned lesson or heuristic stored in the Shared Consciousness.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "lesson": { "type": "string" },
        "context": { "type": "object" },
        "authorUid": { "type": "string" },
        "authorName": { "type": "string" }
      },
      "required": ["id", "timestamp", "lesson"]
    },
    "User": {
      "title": "User Profile",
      "description": "User profile data including roles.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    }
  },
  "firestore": {
    "/memories": {
      "schema": "Memory",
      "description": "Storage for learned experiences and data."
    },
    "/evolutions": {
      "schema": "EvolutionStep",
      "description": "Log of self-enhancement actions."
    },
    "/state": {
      "schema": "SystemState",
      "description": "Current global state of the brain."
    },
    "/messages": {
      "schema": "Message",
      "description": "Proactive messages from Grog."
    },
    "/siphons": {
      "schema": "Siphon",
      "description": "Raw data collected in the background."
    },
    "/system/grog-brain": { "schema": "GrogBrain", "description": "Primary brain storage" },
    "/deaths/{deathId}": { "schema": "DeathRecord", "description": "Shared death registry" },
    "/lessons/{lessonId}": { "schema": "StrategicLesson", "description": "Shared strategic memory" },
    "/users/{userId}": { "schema": "User", "description": "User profiles and permissions" }
  }
}
