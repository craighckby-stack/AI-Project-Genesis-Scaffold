/**
 * @file .env.example
 * @description
 * CENTRAL CONFIGURATION SCHEMA for the DARLEK_CAAN_ENGINE.
 * This file defines the mandatory environment variable contract for system deployment.
 * 
 * @architecture
 * Acts as the 'Environment Manifest'. It enforces a strict separation between:
 * - PUBLIC_CLIENT_LAYER: Exposed to browser (NEXT_PUBLIC_ prefix).
 * - PRIVATE_SERVER_LAYER: Backend-only secrets (No prefix).
 * - AGENTIC_ORCHESTRATION_LAYER: LLM/Model parameters for the 3-tier fallback engine.
 * - TELEMETRY_LAYER: Epistemic logging and system monitoring.
 * 
 * @siphonContext
 * - Siphoned from: vercel/ai (SDK patterns), microsoft/semantic-kernel (Agent endpoints),
 *   and craighckby-stack/darlek-cann-v3 (Multi-tier LLM fallback logic).
 */

# --------------------------------------------------------------------------------------------------
# TIER 1: SYSTEM IDENTITY & ENVIRONMENT
# --------------------------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="DARLEK CANN v3.0"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NODE_ENV="development"

# --------------------------------------------------------------------------------------------------
# TIER 2: AGENTIC ORCHESTRATION (LLM FALLBACK ENGINE)
# --------------------------------------------------------------------------------------------------
# Primary LLM Provider (Gemini)
GEMINI_API_KEY=""

# Secondary/Fallback Providers
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Model Configuration
LLM_DEFAULT_MODEL="gemini-1.5-pro"
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_RETRY_ATTEMPTS=3

# --------------------------------------------------------------------------------------------------
# TIER 3: PERSISTENCE & AUTHENTICATION
# --------------------------------------------------------------------------------------------------
# Database (Prisma/PostgreSQL/SQLite)
DATABASE_URL="file:./dev.db"

# Auth (NextAuth.js)
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Firebase Integration (Client-Side)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""

# --------------------------------------------------------------------------------------------------
# TIER 4: DIAGNOSTICS, TELEMETRY & INTEGRATION
# --------------------------------------------------------------------------------------------------
# Monitoring & Epistemic Logging
SENTRY_DSN=""
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=""
TELEMETRY_ENDPOINT="/api/telemetry/event"

# Stripe (Payment Gateway)
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --------------------------------------------------------------------------------------------------
# SECURITY WARNING:
# 1. Copy to .env.local for local development.
# 2. DO NOT COMMIT .env.local to version control.
# 3. Use platform-specific secret managers (Vercel/AWS/GCP) for production.
# 4. Ensure all variables are validated at runtime via Zod or similar schema validator.
# --------------------------------------------------------------------------------------------------




